common --enable_platform_specific_config

common --flag_alias=swiftcopt=@rules_swift//swift:copt
common --flag_alias=host_swiftcopt=@rules_swift//swift:exec_copt

# Make sure PCM warnings are treated as errors
build --swiftcopt=-Xcc --swiftcopt=-Werror
build --features=treat_warnings_as_errors

# firebase-ios-sdk's Crashlytics sources use `#pragma clang diagnostic ignored`
# for diagnostics this clang doesn't know about, which trips the -Werror above.
# Not what the Firebase example is demonstrating, so scope it away.
build --per_file_copt=.*swiftpkg_firebase_ios_sdk.*@-Wno-unknown-pragmas

# Build perf for SwiftSyntax, shouldn't affect other things
build --swiftcopt=-wmo --swiftcopt=-wmo

# Make sure we can find swiftc
build:linux --repo_env=PATH --action_env=PATH --host_action_env=PATH
build:linux --repo_env=CC=clang
build:linux --//:apple_build_tests=false

build --test_output=errors
build --verbose_failures

build --@rules_apple//apple/build_settings:ios_simulator_device="iPhone 16"
build --@rules_apple//apple/build_settings:ios_simulator_version=26.5

build --macos_minimum_os=13.0 --host_macos_minimum_os=13.0

build:explicit-modules --features=swift.use_c_modules --features=swift.emit_c_module --features=swift.use_explicit_swift_module_map
build:explicit-modules --host_features=swift.use_c_modules --host_features=swift.emit_c_module --host_features=swift.use_explicit_swift_module_map

# --remote_header=x-buildbuddy-api-key=<BUILDBUDDY_API_KEY secret>.
build:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy --remote_timeout=3600
build:buildbuddy --build_metadata=ROLE=CI

try-import %workspace%/user.bazelrc
